APP_NAME="ReCloud Lead Intelligence"
APP_ENV="development"
APP_URL="http://localhost:3000"
API_URL="http://localhost:8000"

NEXT_PUBLIC_APP_NAME="ReCloud Lead Intelligence"
NEXT_PUBLIC_API_URL="http://localhost:8000"

DATABASE_URL="postgresql://postgres:postgres@postgres:5432/recloud_leads"
POSTGRES_USER="postgres"
POSTGRES_PASSWORD="postgres"
POSTGRES_DB="recloud_leads"

REDIS_URL="redis://redis:6379/0"

JWT_SECRET="replace_with_secure_random_string"
JWT_ALGORITHM="HS256"
JWT_ACCESS_TOKEN_EXPIRE_MINUTES="1440"

OPENAI_API_KEY="replace_with_openai_api_key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4.1-mini"

FIRECRAWL_API_KEY="replace_with_firecrawl_api_key"
FIRECRAWL_BASE_URL="https://api.firecrawl.dev"

JOBSPY_ENABLED="true"
JOBSPY_DEFAULT_COUNTRY="india"
JOBSPY_DEFAULT_RESULTS_LIMIT="100"
JOBSPY_PROXIES=""

REACHER_API_URL="http://reacher:8080"
REACHER_API_KEY="replace_if_using_hosted_reacher"

ZEROBOUNCE_API_KEY="replace_with_zerobounce_api_key"
HUNTER_API_KEY="replace_with_hunter_api_key"
APOLLO_API_KEY="replace_with_apollo_api_key"

BASEROW_API_URL="replace_with_baserow_api_url"
BASEROW_API_KEY="replace_with_baserow_api_key"

TWENTY_API_URL="replace_with_twenty_crm_api_url"
TWENTY_API_KEY="replace_with_twenty_crm_api_key"

HUBSPOT_API_KEY="replace_with_hubspot_private_app_token"

N8N_WEBHOOK_URL="replace_with_n8n_webhook_url"

SMTP_HOST="replace_with_smtp_host"
SMTP_PORT="587"
SMTP_USER="replace_with_smtp_user"
SMTP_PASSWORD="replace_with_smtp_password"
SMTP_FROM_EMAIL="replace_with_sender_email"

ENABLE_CONTACT_ENRICHMENT="false"
ENABLE_EMAIL_VERIFICATION="true"
ENABLE_AI_OUTREACH_GENERATION="true"
ENABLE_CSV_EXPORT="true"
ENABLE_CRM_SYNC="false"
ENABLE_OUTREACH_SENDING="false"
